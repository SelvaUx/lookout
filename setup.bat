@echo off
setlocal
cd /d "%~dp0"

echo ============================================
echo   Lookout - one-click setup
echo ============================================
echo.

where python >nul 2>nul
if errorlevel 1 goto :nopython

if exist ".venv\Scripts\python.exe" goto :havevenv
echo [1/3] Creating virtual environment...
python -m venv .venv
if errorlevel 1 goto :venvfail
goto :install

:havevenv
echo [1/3] Virtual environment already exists.

:install
echo [2/3] Installing Lookout and dependencies...
".venv\Scripts\python.exe" -m pip install --upgrade pip
".venv\Scripts\python.exe" -m pip install -e .
if errorlevel 1 goto :pipfail

echo [3/3] Vision model
where ollama >nul 2>nul
if errorlevel 1 goto :noollama

echo.
echo   This PC (16 GB RAM, no GPU) runs best with a SMALL local model.
echo   Bigger models read screens better but are much slower on CPU.
echo.
echo     1) moondream         ~1.7 GB   lightest, fast   (recommended)
echo     2) gemma3:4b         ~3.3 GB   better quality, slower
echo     3) qwen2.5vl:3b      ~3.2 GB   strong at reading text
echo     4) llama3.2-vision   ~7.9 GB   heavy - really needs a GPU
echo     5) Skip - I will use a cloud API (Gemini/OpenAI/Claude)
echo.
set "CHOICE="
set /p "CHOICE=   Choose [1-5]: "
if "%CHOICE%"=="1" set "MODEL=moondream"
if "%CHOICE%"=="2" set "MODEL=gemma3:4b"
if "%CHOICE%"=="3" set "MODEL=qwen2.5vl:3b"
if "%CHOICE%"=="4" set "MODEL=llama3.2-vision"
if not defined MODEL goto :cloud
goto :pull

:pull
echo.
echo   Downloading %MODEL% ... this can take several minutes.
ollama pull %MODEL%
if errorlevel 1 goto :pullfail
call :writeenv
goto :done

:cloud
if not exist ".env" copy /y ".env.example" ".env" >nul
echo.
echo   OK - using a cloud backend. It needs no local GPU/RAM.
echo   Open the new .env file, uncomment ONE backend, and paste your API key.
goto :done

:noollama
echo       [!] Ollama not found. Install it from https://ollama.com/download
echo           then run:  ollama pull moondream
goto :done

:done
echo.
echo ============================================
echo   Setup complete!
echo   Double-click start.bat to launch Lookout.
echo ============================================
pause
exit /b 0

:writeenv
if exist ".env" (
  echo   .env already exists - leaving it untouched.
  exit /b 0
)
> .env echo # Lookout settings (auto-generated by setup.bat)
>> .env echo LOOKOUT_BACKEND=ollama
>> .env echo LOOKOUT_OLLAMA_MODEL=%MODEL%
>> .env echo LOOKOUT_CAPTURE_INTERVAL=3.0
>> .env echo LOOKOUT_MAX_IMAGE_SIDE=960
>> .env echo LOOKOUT_ACT_MAX_STEPS=10
>> .env echo LOOKOUT_ACT_STEP_PAUSE=0.8
echo   Wrote .env tuned for CPU-only use (model: %MODEL%).
exit /b 0

:pullfail
echo [X] Could not download the model. Is Ollama running? Try:  ollama pull %MODEL%
pause
exit /b 1

:nopython
echo [X] Python was not found on PATH.
echo     Install Python 3.9+ from https://www.python.org/downloads/
echo     and tick "Add Python to PATH" during install.
pause
exit /b 1

:venvfail
echo [X] Could not create the virtual environment.
pause
exit /b 1

:pipfail
echo [X] Dependency installation failed. See the messages above.
pause
exit /b 1
