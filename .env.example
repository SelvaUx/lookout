# Lookout configuration (copy to .env and edit)

# Vision backend: ollama | anthropic | openai | gemini
LOOKOUT_BACKEND=ollama

# --- Ollama (local, default) ---
LOOKOUT_OLLAMA_URL=http://localhost:11434
LOOKOUT_OLLAMA_MODEL=llama3.2-vision

# --- Anthropic (optional, uncomment to use) ---
# ANTHROPIC_API_KEY=sk-ant-...
# LOOKOUT_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- OpenAI (optional) ---
# OPENAI_API_KEY=sk-...
# LOOKOUT_OPENAI_MODEL=gpt-4o

# --- Google Gemini (optional) ---
# (no SDK needed - uses httpx; enable "Generative Language API" in your project)
# GOOGLE_API_KEY=...
# LOOKOUT_GEMINI_MODEL=gemini-2.0-flash

# --- Capture tuning ---
LOOKOUT_CAPTURE_INTERVAL=2.0
LOOKOUT_CAPTURE_MONITOR=1
LOOKOUT_CAPTURE_QUALITY=70
LOOKOUT_MAX_IMAGE_SIDE=1280

# --- Watch mode ---
LOOKOUT_WATCH_THRESHOLD=0.06
LOOKOUT_WATCH_IDLE_WINDOW=30.0

# --- Memory ---
LOOKOUT_MEMORY_SIZE=8

# --- Act mode safety ---
LOOKOUT_ACT_MAX_STEPS=20
LOOKOUT_ACT_STEP_PAUSE=0.6
LOOKOUT_ACT_SAFETY_PAUSE=true
